---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Clínica de Alergia Dr. Mauro Jorge na Rua Edmundo Lins, 8 - Copacabana, RJ (ao lado do Metrô Siqueira Campos). Fundada em 1994, atendimento adulto e pediátrico, particular e convênios.",
  canonicalURL = Astro.url.href
} = Astro.props;

const siteUrl = "https://www.clinicadealergiamj.com.br/";

const geoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalClinic", "Physician"],
      "@id": `${siteUrl}#clinic`,
      "name": "Clínica de Alergia Dr. Mauro Jorge",
      "foundingDate": "1994",
      "description": description,
      "url": siteUrl,
      "logo": `${siteUrl}images/logo.webp`,
      "image": `${siteUrl}images/clinica-lateral.webp`,
      "telephone": "+55-21-2235-4549",
      "email": "clinicadealergia.mj@uol.com.br",
      "medicalSpecialty": "AllergyAndImmunology",
      "hasMap": "https://g.co/kgs/Ca8CF1P",
      "founder": {
        "@type": "Person",
        "name": "Dr. Mauro Roberto Nahuz Jorge",
        "jobTitle": "Médico Alergista e Imunologista",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Pontifícia Universidade Católica do Rio de Janeiro (PUC-RJ)"
        }
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Edmundo Lins, 8",
        "addressLocality": "Rio de Janeiro",
        "addressRegion": "RJ",
        "postalCode": "22031-020",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -22.9672,
        "longitude": -43.1868
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:30"
        }
      ],
      "areaServed": [
        { "@type": "Neighborhood", "name": "Copacabana" },
        { "@type": "Neighborhood", "name": "Ipanema" },
        { "@type": "Neighborhood", "name": "Leblon" },
        { "@type": "Neighborhood", "name": "Botafogo" },
        { "@type": "Neighborhood", "name": "Leme" },
        { "@type": "City", "name": "Rio de Janeiro" }
      ],
      "availableService": [
        { "@type": "MedicalProcedure", "name": "Consultas médicas em Alergia e Imunologia (Adulto e Pediátrico)" },
        { "@type": "MedicalTest", "name": "Testes cutâneos de leitura imediata (Prick Test)" },
        { "@type": "MedicalTest", "name": "Testes Intradérmicos" },
        { "@type": "MedicalTest", "name": "Testes de Contato (Patch Test)" },
        { "@type": "MedicalTherapy", "name": "Imunoterapia específica para alérgenos (Vacinas para Alergia)" }
      ],
      "sameAs": [
        "https://g.co/kgs/Ca8CF1P",
        "https://wa.me/message/IE4QW2RRY3PZC1"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Onde fica a Clínica de Alergia Dr. Mauro Jorge em Copacabana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A clínica fica na Rua Edmundo Lins, 8, em Copacabana, Rio de Janeiro - RJ (CEP 22031-020), ao lado da Estação Metrô Siqueira Campos, com atendimento de segunda a sexta-feira, das 09:00h às 18:30h."
          }
        },
        {
          "@type": "Question",
          "name": "Quais convênios a Clínica de Alergia Dr. Mauro Jorge aceita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Além de atendimento particular, a clínica aceita Amil, Bradesco Saúde, SulAmérica Saúde, Unimed, Golden Cross, Porto Seguro Saúde, Saúde Caixa, CASSI, CABERJ Saúde, GEAP, NotreDame Intermédica, Mediservice, Prevent Senior, PASA, Vale, AMAFRERJ, CAMARJ, BC Saúde, IPALERJ Saúde e Mútua."
          }
        },
        {
          "@type": "Question",
          "name": "Quais exames e tratamentos de alergia são realizados na clínica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Realizamos consultas médicas em Alergia e Imunologia (adulto e pediátrico), testes cutâneos de leitura imediata, testes intradérmicos, testes de contato e imunoterapia específica para alérgenos (vacinas para alergia)."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Dados Estruturados GEO (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(geoSchema)} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NRDJRH4W');</script>
    <!-- End Google Tag Manager -->

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NRDJRH4W"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
  </body>
</html>