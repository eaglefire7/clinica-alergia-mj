---
const whatsappLink = "https://wa.me/message/IE4QW2RRY3PZC1";
---

<div class="h-[3px] bg-[#3E7C5A]"></div>

<!-- Footer -->
<footer class="bg-[#F7F3EC] text-[#2B2B2B] py-12 border-t border-[#1F3A3D]/10">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10">
      <img src="/images/logo.webp" alt="Clínica de Alergia Dr. Mauro Jorge" class="h-24 w-auto mx-auto mb-4" />
      <p class="font-serif text-lg text-[#1F3A3D]">Há 30 anos promovendo qualidade de vida!</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-5 gap-8 text-sm">
      <div>
        <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path fill-rule="evenodd" d="M11.54 22.351l.026.017.006.003a.75.75 0 00.928 0l.006-.003.026-.017.101-.062a23.851 23.851 0 003.192-2.224c1.772-1.505 3.936-3.9 5.446-6.916C21.12 10.5 21.75 8.313 21.75 6a9.75 9.75 0 10-19.5 0c0 2.313.63 4.5 1.929 7.15 1.51 3.017 3.674 5.41 5.446 6.916a23.848 23.848 0 003.293 2.286zM12 9a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z" clip-rule="evenodd" /></svg></span>
          Endereço
        </p>
        <a href="https://g.co/kgs/Ca8CF1P" target="_blank" class="hover:text-[#3E7C5A] transition-colors duration-300 block">
          Rua Edmundo Lins, 8 - Copacabana<br />Rio de Janeiro - RJ.<br />22031-020
        </a>
      </div>

      <div>
        <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z" clip-rule="evenodd" /></svg></span>
