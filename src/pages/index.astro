---
import Layout from '../layouts/Layout.astro';

const whatsappLink = "https://wa.me/message/IE4QW2RRY3PZC1";

const condicoes = [
  "Asma", "Rinite Alérgica", "Sinusite", "Dermatite Atópica",
  "Dermatite de Contato", "Urticária", "Alergia a picada de Insetos",
  "Alergia Alimentar", "Alergia Medicamentosa", "Infecções de Repetição (Herpes, Candidíase, entre outras)"
];

const conveniosDrive = [
  "1rnR6sVTZU_xtq6uXJe-zqiu0uolYCBhD",
  "1FP0lwppCu-reRZHpoEiZygGEMSjUbfqN",
  "1iHg_sc6UV1ndCc6LLxnnzKDN88KiMbt5",
  "1vOA2kNGh4klJQVbvBcLjx011qxNyDEYH",
  "1yq9zhWwjt4txv-_ythCByWOPUtRwguNC",
  "140BwUCVLBCccI7RAeNTkoQTl_c0B5IG-",
  "1I9xqbkrB_7L0R8W9bEuerR07SKeFFhH8",
  "10-WAdxJEq5NmXip5b9MB87bMLvC47qzn",
  "1BPKA35bO_Fcx5Vs8zwCKvCZR7vxXj2Ai",
];
---

<Layout title="Clínica de Alergia Dr. Mauro Jorge | Copacabana, RJ">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.css">
    <script src="https://static.elfsight.com/platform/platform.js" data-use-service-core defer></script>
  </Fragment>

  <!-- Cabecalho com contatos -->
  <div class="bg-[#1F3A3D] text-[#F7F3EC] text-xs">
    <div class="max-w-6xl mx-auto px-6 py-2 flex flex-wrap items-center justify-center gap-x-8 gap-y-1 text-center">
      <a href="tel:2122354549" class="flex items-center gap-1.5 transition-colors duration-300 hover:text-[#C89B3C]">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3 h-3"><path d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" /></svg></span>
        (21) 2235-4549
      </a>
      <a href="tel:2122355991" class="flex items-center gap-1.5 transition-colors duration-300 hover:text-[#C89B3C]">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3 h-3"><path d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" /></svg></span>
        (21) 2235-5991
      </a>
      <a href={whatsappLink} target="_blank" class="flex items-center gap-1.5 transition-colors duration-300 hover:text-[#C89B3C]">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path d="M12 2.25c-2.429 0-4.817.178-7.152.521C2.87 3.061 1.5 4.795 1.5 6.741v6.018c0 1.946 1.37 3.68 3.348 3.97.877.129 1.761.226 2.652.292V21a.75.75 0 001.28.53l4.184-4.183a.39.39 0 01.266-.112c2.006-.05 3.982-.226 5.922-.522 1.978-.29 3.348-2.023 3.348-3.97V6.741c0-1.947-1.37-3.68-3.348-3.97A49.145 49.145 0 0012 2.25z" /></svg></span>
        WhatsApp
      </a>
    </div>
  </div>

  <!-- Header fixo -->
  <header class="sticky top-0 z-50 bg-[#F7F3EC]/95 backdrop-blur-sm border-b border-[#1F3A3D]/10 shadow-sm">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-3 transition-transform duration-300 hover:scale-[1.02]">
        <img src="/images/logo.webp" alt="Clínica de Alergia Dr. Mauro Jorge" class="h-16 w-auto" />
        <span class="font-serif leading-tight text-[#1F3A3D]">
          Clínica de Alergia<br /><span class="text-sm">Dr. Mauro Jorge</span>
        </span>
      </a>
      <div class="hidden sm:flex gap-8 text-sm text-[#2B2B2B]">
        <a href="/" class="relative transition-colors duration-300 hover:text-[#C89B3C]">Home</a>
        <a href="/servicos" class="relative transition-colors duration-300 hover:text-[#C89B3C]">Serviços</a>
        <a href="/convenios" class="relative transition-colors duration-300 hover:text-[#C89B3C]">Convênios</a>
      </div>
      <a href={whatsappLink} target="_blank" class="bg-[#1F3A3D] text-white text-sm px-4 py-2 rounded-full transition-colors duration-300 hover:bg-[#C89B3C] hover:text-[#1F3A3D]">
        Agende Aqui
      </a>
    </nav>
  </header>

  <!-- Hero com foto de fundo -->
  <section class="relative">
    <div class="absolute inset-0">
      <img src="/images/hero-bg.jpeg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-[#1F3A3D]/70"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-6 py-28 text-center text-[#F7F3EC]">
      <p class="uppercase tracking-widest text-sm text-[#C89B3C] font-medium mb-4">
        Há 30 anos promovendo qualidade de vida
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl font-semibold leading-tight max-w-3xl mx-auto text-white">
        Clínica de Alergia<br />Dr. Mauro Jorge
      </h1>
      <p class="mt-5 font-serif text-xl sm:text-2xl text-[#C89B3C] max-w-2xl mx-auto">
        Referência no tratamento de doenças alérgicas<br />no Rio de Janeiro
      </p>
      <p class="mt-6 text-lg opacity-90 max-w-2xl mx-auto">
        Atendimento adulto e pediátrico, particular ou por convênio.
      </p>
      <a href={whatsappLink} target="_blank" class="inline-block mt-8 bg-[#C89B3C] text-[#1F3A3D] font-medium px-8 py-3 rounded-full hover:bg-[#b98a2c] transition">
        Agendar Consulta
      </a>
    </div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Quem Somos -->
  <section class="max-w-6xl mx-auto px-6 py-20 grid sm:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="font-serif text-3xl text-[#1F3A3D] mb-6">Quem Somos</h2>
      <p class="text-[#2B2B2B]/80 leading-relaxed">
        Fundada há 30 anos (1994) pelo Dr. Mauro Roberto Nahuz Jorge, especialista em Alergia pela PUC-RJ desde 1977, a Clínica de Alergia Dr. Mauro Jorge é referência no tratamento de doenças alérgicas respiratórias e cutâneas.
      </p>
      <p class="text-[#2B2B2B]/80 leading-relaxed mt-4">
        Localizada no coração de Copacabana, tem como missão contribuir para a melhora da qualidade de vida de seus pacientes, buscando o controle das doenças alérgicas.
      </p>
    </div>
    <img src="/images/clinica-lateral.webp" alt="Fachada da Clínica de Alergia Dr. Mauro Jorge" class="rounded-2xl w-full h-80 object-cover" />
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Alergia e Imunologia -->
  <section class="bg-[#F7F3EC] py-20">
    <div class="max-w-6xl mx-auto px-6 grid sm:grid-cols-2 gap-12 items-center">
      <img src="/images/consultorio.jpeg" alt="Consultório da clínica" class="rounded-2xl w-full h-96 object-cover order-2 sm:order-1" />
      <div class="order-1 sm:order-2">
        <h2 class="font-serif text-3xl text-[#1F3A3D] mb-2">Alergia e Imunologia</h2>
        <p class="text-[#2B2B2B]/70 mb-6">Atendimento Adulto e Pediátrico, Particular ou Convênio:</p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-[#2B2B2B]/80">
          {condicoes.map((c) => (
            <li class="flex items-start gap-2">
              <span class="text-[#C89B3C] mt-1">•</span> {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Servicos -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="font-serif text-3xl text-[#1F3A3D] text-center mb-12">Serviços</h2>
    <div class="grid sm:grid-cols-3 gap-8">
      <div class="text-center flex flex-col">
        <h3 class="font-serif text-lg text-[#1F3A3D] mb-4 min-h-[3.5rem] flex items-end justify-center">Consultas médicas em Alergia e Imunologia</h3>
        <img src="/images/servico-consultas.webp" alt="Consultas médicas em Alergia e Imunologia" class="w-full h-48 object-cover rounded-2xl mb-4" />
        <p class="text-sm text-[#2B2B2B]/70">Consultas médicas em Alergia e Imunologia</p>
      </div>
      <div class="text-center flex flex-col">
        <h3 class="font-serif text-lg text-[#1F3A3D] mb-4 min-h-[3.5rem] flex items-end justify-center">Testes Imunoalérgicos</h3>
        <img src="/images/servico-testes.jpeg" alt="Testes Imunoalérgicos" class="w-full h-48 object-cover rounded-2xl mb-4" />
        <p class="text-sm text-[#2B2B2B]/70">
          Testes cutâneos de leitura imediata<br />
          Testes Intradérmicos<br />
          Testes de Contato
        </p>
      </div>
      <div class="text-center flex flex-col">
        <h3 class="font-serif text-lg text-[#1F3A3D] mb-4 min-h-[3.5rem] flex items-end justify-center">Imunoterapia específica para alérgenos</h3>
        <img src="/images/servico-vacinas.jpeg" alt="Imunoterapia específica para alérgenos" class="w-full h-48 object-cover rounded-2xl mb-4" />
        <p class="text-sm text-[#2B2B2B]/70">Vacinas para Alergia</p>
      </div>
    </div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Atendimentos / Convenios (carrossel automatico) -->
  <section class="bg-[#1F3A3D] py-16 text-[#F7F3EC]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-serif text-2xl text-center mb-2">Rede de Atendimento por Convênio</h2>
      <p class="text-center opacity-70 mb-10">
        Veja lista completa de convênios <a href="/convenios" class="underline hover:text-[#C89B3C]">aqui</a>
      </p>

      <div class="convenios-slider">
        {conveniosDrive.map((id) => (
          <div><img src={`https://drive.google.com/thumbnail?id=${id}`} alt="Convênio" /></div>
        ))}
      </div>

      <div class="text-center mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a href={whatsappLink} target="_blank" class="bg-[#C89B3C] text-[#1F3A3D] font-medium px-8 py-3 rounded-full hover:bg-[#b98a2c] transition">
          Agende Aqui
        </a>
        <a href="/convenios" class="border border-[#F7F3EC]/40 px-8 py-3 rounded-full hover:bg-white/10 transition">
          Veja lista completa de convênios
        </a>
      </div>
    </div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <style>
    .convenios-slider img {
      border-radius: 12px;
      background: white;
      padding: 12px;
      max-width: calc(100% - 16px);
      margin: 0 8px;
    }
    .convenios-slider .slick-prev,
    .convenios-slider .slick-next {
      display: none !important;
    }
  </style>

  <!-- Avaliacao Google (Elfsight) -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="elfsight-app-59664342-ff97-4c9d-8069-37e8e0b3dac1" data-elfsight-app-lazy></div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Mapa -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="font-serif text-2xl text-[#1F3A3D] text-center mb-2">Onde estamos</h2>
    <p class="text-center text-[#2B2B2B]/70 mb-4">Localizada no coração de Copacabana, ao lado da estação do Metrô Siqueira Campos.</p>
    <div class="flex justify-center mb-8">
      <span class="inline-flex items-center gap-2 bg-[#1F3A3D] text-white text-xs font-medium px-4 py-2 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-4 h-4"><path d="M12 2.25c-4.142 0-7.5.672-7.5 4.5v9a3 3 0 003 3l-1.5 1.5v.75h2.25l1.5-1.5h4.5l1.5 1.5h2.25v-.75l-1.5-1.5a3 3 0 003-3v-9c0-3.828-3.358-4.5-7.5-4.5zM7.5 15.75a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm9 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM18 10.5H6V6.75h12v3.75z" /></svg>
        Estação Metrô Siqueira Campos
      </span>
    </div>
    <div class="rounded-2xl overflow-hidden h-96">
      <iframe class="w-full h-full border-0" loading="lazy" src="https://www.google.com/maps?q=Rua+Edmundo+Lins,+8+-+Copacabana,+Rio+de+Janeiro+-+RJ,+22031-020&output=embed">
      </iframe>
    </div>
  </section>

  <div class="h-[3px] bg-[#3E7C5A]"></div>

  <!-- Footer -->
  <footer class="bg-[#F7F3EC] text-[#2B2B2B] py-12 border-t border-[#1F3A3D]/10">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <img src="/images/logo.webp" alt="Clínica de Alergia Dr. Mauro Jorge" class="h-24 w-auto mx-auto mb-4" />
        <p class="font-serif text-lg text-[#1F3A3D]">Há 30 anos promovendo qualidade de vida!</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-8 text-sm">
        <div>
          <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path fill-rule="evenodd" d="M11.54 22.351l.026.017.006.003a.75.75 0 00.928 0l.006-.003.026-.017.101-.062a23.851 23.851 0 003.192-2.224c1.772-1.505 3.936-3.9 5.446-6.916C21.12 10.5 21.75 8.313 21.75 6a9.75 9.75 0 10-19.5 0c0 2.313.63 4.5 1.929 7.15 1.51 3.017 3.674 5.41 5.446 6.916a23.848 23.848 0 003.293 2.286zM12 9a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z" clip-rule="evenodd" /></svg></span>
            Endereço
          </p>
          <a href="https://g.co/kgs/Ca8CF1P" target="_blank" class="hover:text-[#3E7C5A] transition-colors duration-300 block">
            Rua Edmundo Lins, 8 - Copacabana<br />Rio de Janeiro - RJ.<br />22031-020
          </a>
        </div>

        <div>
          <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z" clip-rule="evenodd" /></svg></span>
            Horário
          </p>
          <p class="text-[#2B2B2B]/70">Segunda-feira a sexta-feira:</p>
          <p class="text-[#2B2B2B]/70">09:00h - 18:30h</p>
        </div>

        <div>
          <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-[#3E7C5A] flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
            Serviços
          </p>
          <div class="flex flex-col gap-1">
            <a href="/servicos#consultas" class="hover:text-[#3E7C5A] transition-colors duration-300">Consultas médicas em Alergia e Imunologia</a>
            <a href="/servicos#testes" class="hover:text-[#3E7C5A] transition-colors duration-300">Testes Imunoalérgicos</a>
            <a href="/servicos#vacinas" class="hover:text-[#3E7C5A] transition-colors duration-300">Vacinas para Alergia</a>
          </div>
        </div>

        <div>
          <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-[#3E7C5A] flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" /></svg>
            Convênios
          </p>
          <p class="text-[#2B2B2B]/70">
            Veja lista completa de convênios <a href="/convenios" class="underline hover:text-[#3E7C5A] transition-colors duration-300">aqui</a>
          </p>
        </div>

        <div>
          <p class="flex items-center gap-2 text-[#2B2B2B]/90 mb-2 font-medium">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#3E7C5A] flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-3.5 h-3.5"><path d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" /></svg></span>
            Contatos
          </p>
          <div class="flex flex-col gap-1">
            <a href="tel:2122354549" class="hover:text-[#3E7C5A] transition-colors duration-300">(21) 2235-4549</a>
            <a href="tel:2122355991" class="hover:text-[#3E7C5A] transition-colors duration-300">(21) 2235-5991</a>
            <a href={whatsappLink} target="_blank" class="hover:text-[#3E7C5A] transition-colors duration-300">WhatsApp (21) 97122-6940</a>
            <a href="mailto:clinicadealergia.mj@uol.com.br" class="hover:text-[#3E7C5A] transition-colors duration-300 break-words">clinicadealergia.mj@uol.com.br</a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <div class="inline-block">
        <img src="/images/logo-rodape.png" alt="Clínica de Alergia Dr. Mauro Jorge" class="h-12 w-auto" />
      </div>
    </div>

    <div class="text-center mt-6 text-xs opacity-60">
      Desenvolvido por <a href="https://magnect.com.br" class="underline">Magnect©</a>
    </div>
  </footer>

  <script is:inline src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      $('.convenios-slider').slick({
